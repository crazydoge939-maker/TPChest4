-- ============================================================
-- Toggle logic: turning ON immediately auto-teleports
-- ============================================================ 
toggleBtn.MouseButton1Click:Connect(function()
	tpActive = not tpActive
	if tpActive then
		toggleBtn.Text = "TP: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
		startAutoTP()
	else
		toggleBtn.Text = "TP: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	end
end)

-- ============================================================
-- Portal button logic
-- ============================================================ 
portalBtn.MouseButton1Click:Connect(function()
	teleportToPortal()
end)

-- ============================================================
-- Dragging logic
-- ============================================================ 
local dragging = false
local dragStart = nil
local startPos = nil

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- ============================================================
-- Auto-teleport to newly added pages while TP is active
-- ============================================================ 
local folder = getPageFolder()
if folder then
	-- Highlight existing pages
	highlightAllPages()

	-- Highlight new pages and auto-teleport if TP is active
	folder.ChildAdded:Connect(function(child)
		task.wait(0.1)
		if child:IsA("BasePart") then
			addHighlight(child)
			if tpActive and not tpRunning then
				startAutoTP()
			end
		end
	end)
end
