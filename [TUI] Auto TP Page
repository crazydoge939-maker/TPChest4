local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- ============================================================
-- Find the Page folder
-- ============================================================
local function getPageFolder()
	local map = Workspace:FindFirstChild("Map")
	if not map then return nil end
	return map:FindFirstChild("Page")
end

-- Cache original HoldDuration values so we can restore them
local originalHoldDurations = {}
local tpActive = false
local tpRunning = false -- prevents multiple loops

local function setHoldDurations(active)
	local folder = getPageFolder()
	if not folder then return end
	for _, page in ipairs(folder:GetChildren()) do
		local prompt = page:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			if active then
				if originalHoldDurations[page] == nil then
					originalHoldDurations[page] = prompt.HoldDuration
				end
				prompt.HoldDuration = 0
			else
				if originalHoldDurations[page] ~= nil then
					prompt.HoldDuration = originalHoldDurations[page]
				end
			end
		end
	end
end

-- ============================================================
-- Teleport player to face a Page at the same Y level
-- ============================================================ 
local function teleportToPage(page)
	local character = player.Character
	if not character then return false end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	local pagePos = page.Position
	local pageLook = page.CFrame.LookVector

	-- Stand in front of the page, facing it, at the same Y level
	local standDistance = 2
	local targetPos = Vector3.new(
		pagePos.X - pageLook.X * standDistance,
		pagePos.Y,
		pagePos.Z - pageLook.Z * standDistance
	)

	-- Face the page directly
	local lookAt = Vector3.new(pagePos.X, targetPos.Y, pagePos.Z)
	local newCFrame = CFrame.lookAt(targetPos, lookAt)

	hrp.CFrame = newCFrame

	-- Activate the ProximityPrompt: since we can't fire Triggered from
	-- a script, replicate the Loot script behaviour (page:Destroy()).
	-- This is client-side only.
	task.wait(0.1)
	if page and page.Parent then
		page:Destroy()
	end
	return true
end

-- ============================================================
-- Auto-teleport loop: iterate through all pages automatically
-- ============================================================
local function startAutoTP()
	if tpRunning then return end
	tpRunning = true

	task.spawn(function()
		while tpActive do
			local folder = getPageFolder()
			if not folder then break end

			local pages = {}
			for _, child in ipairs(folder:GetChildren()) do
				if child:IsA("BasePart") then
					table.insert(pages, child)
				end
			end

			if #pages == 0 then break end

			-- Sort by name for consistent order
			table.sort(pages, function(a, b)
				return a.Name < b.Name
			end)

			for _, page in ipairs(pages) do
				if not tpActive then break end
				-- Re-check the page still exists
				if page and page.Parent then
					teleportToPage(page)
					task.wait(0.5)
				end
			end
			break
		end
		tpRunning = false
	end)
end

