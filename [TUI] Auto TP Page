local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- ============================================================
-- Find the Page folder
-- ============================================================
local function getPageFolder()
	local map = Workspace:FindFirstChild("Map")
	if not map then return nil end
	return map:FindFirstChild("Page")
end

local tpActive = false
local tpRunning = false -- prevents multiple loops

-- ============================================================
-- Permanent highlight on all pages
-- ============================================================
local function addHighlight(page)
	if not page:FindFirstChildOfClass("Highlight") then
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.fromRGB(255, 255, 0)
		hl.OutlineColor = Color3.fromRGB(255, 215, 0)
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.Parent = page
	end
end

local function highlightAllPages()
	local folder = getPageFolder()
	if not folder then return end
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			addHighlight(child)
		end
	end
end

-- ============================================================
-- Teleport player to face a Page at the same Y level
-- ============================================================ 
local function teleportToPage(page)
	local character = player.Character
	if not character then return false end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	local pagePos = page.Position
	-- Page is thin on its local X axis (Size 0.125 x 4 x 2),
	-- so the large face is perpendicular to RightVector, not LookVector.
	local pageRight = page.CFrame.RightVector

	-- Stand in front of the large face, facing it, at the same Y level
	local standDistance = 3
	local targetPos = pagePos - pageRight * standDistance

	-- Face the page directly
	local lookAt = pagePos
	local newCFrame = CFrame.lookAt(targetPos, lookAt)

	hrp.CFrame = newCFrame

	-- Force the camera to look at the page
	local camera = Workspace.CurrentCamera
	if camera then
		local eyePos = targetPos + Vector3.new(0, 2, 0)
		camera.CFrame = CFrame.lookAt(eyePos, pagePos)
	end

	return true
end

-- ============================================================
-- Auto-teleport loop: iterate through all pages automatically
-- ============================================================
local function startAutoTP()
	if tpRunning then return end
	tpRunning = true

	task.spawn(function()
		while tpActive do
			local folder = getPageFolder()
			if not folder then break end

			local pages = {}
			for _, child in ipairs(folder:GetChildren()) do
				if child:IsA("BasePart") then
					table.insert(pages, child)
				end
			end

			if #pages == 0 then break end

			-- Sort by name for consistent order
			table.sort(pages, function(a, b)
				return a.Name < b.Name
			end)

			for _, page in ipairs(pages) do
				if not tpActive then break end
				-- Re-check the page still exists
				if page and page.Parent then
					teleportToPage(page)
					-- Wait here until the page is collected (destroyed)
					while tpActive and page and page.Parent do
						task.wait(0.1)
					end
				end
			end
		end
		tpRunning = false
	end)
end

-- ============================================================
-- Teleport player to the Portal
-- ============================================================ 
local function teleportToPortal()
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local map = Workspace:FindFirstChild("Map")
	if not map then return end
	local portal = map:FindFirstChild("Portal")
	if not portal or not portal:IsA("BasePart") then return end

	local portalPos = portal.Position
	local portalLook = portal.CFrame.LookVector
	local standDistance = 2
	local targetPos = Vector3.new(
		portalPos.X - portalLook.X * standDistance,
		portalPos.Y,
		portalPos.Z - portalLook.Z * standDistance
	)
	local lookAt = Vector3.new(portalPos.X, targetPos.Y, portalPos.Z)
	hrp.CFrame = CFrame.lookAt(targetPos, lookAt)
end

