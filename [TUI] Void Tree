-- Динамически подсвечивает все модели SlenderTree и Witch и показывает оповещение
-- при спавне новых объектов. UI полностью на Scale — корректно на любых экранах.
-- Поиск идёт по всем потомкам Workspace независимо от вложенности папок.
-- Для каждого типа цели — своя независимая панель.

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local HIGHLIGHT_NAME = "TreeHighlight"
local localPlayer = Players.LocalPlayer

-- ===== Настройки телепорта =====
local PLACE_ID = game.PlaceId
-- Диапазон безопасного времени: 18:00 = 18.0, 20:30 = 20.5
local SAFE_TIME_START = 18.0
local SAFE_TIME_END = 20.1
-- Интервал проверки (секунды)
local CHECK_INTERVAL = 1
-- Задержка перед телепортом после обнаружения отсутствия целей (секунды)
local TELEPORT_DELAY = 1

-- Проверка, находится ли текущее время в безопасном диапазоне 18:00-20:30
local function isSafeTime()
	local clockTime = Lighting.ClockTime
	return clockTime >= SAFE_TIME_START and clockTime <= SAFE_TIME_END
end

-- Есть ли хотя бы одна цель (SlenderTree или Witch)
local function hasTargets()
	for _, descendant in workspace:GetDescendants() do
		if descendant:IsA("Model") and (descendant.Name == "SlenderTree" or descendant.Name == "Witch") then
			return true
		end
	end
	return false
end

-- ===== Телепорт на случайный сервер =====
-- Собираем список публичных серверов через API, исключаем текущий,
-- затем выбираем случайный и телепортируемся в него.
local function getPublicServers()
	local servers = {}
	local cursor = ""

	local ok = pcall(function()
		repeat
			local url = "https://www.roblox.com/games/10523498173/Trollge-Universe-Incident" .. PLACE_ID
				.. "/servers/Public?sortOrder=2&excludeFullGames=true&limit=100"
				.. (cursor ~= "" and ("&cursor=" .. cursor) or "")

			local response = HttpService:GetAsync(url)
			local data = HttpService:JSONDecode(response)

			for _, serverInfo in ipairs(data.data) do
				-- Пропускаем текущий сервер и заполненные
				if serverInfo.id ~= game.JobId and serverInfo.playing < serverInfo.maxPlayers then
					table.insert(servers, serverInfo.id)
				end
			end

			cursor = data.nextPageCursor or ""
		until cursor == ""
	end)

	if not ok then
		warn("[SlenderTreeHighlight] Не удалось получить список серверов")
		return nil
	end
	return servers
end

local function teleportToRandomServer()
	local servers = getPublicServers()

	if not servers or #servers == 0 then
		-- Других публичных серверов сейчас нет — телепортироваться некуда.
		-- Основной цикл через пару секунд повторит попытку.
		print("[SlenderTreeHighlight] Других серверов не найдено, повторю попытку позже")
		return
	end

	local randomJobId = servers[math.random(1, #servers)]
	print("[SlenderTreeHighlight] Телепортация на случайный сервер (JobId: " .. randomJobId .. ", вариантов: " .. #servers .. ")")
	pcall(function()
		TeleportService:TeleportToPlaceInstance(PLACE_ID, randomJobId, localPlayer)
	end)
end

-- Если телепорт сорвался (сервер заполнился/закрылся и т.п.) —
-- пробуем другой случайный сервер, а не матчмейкинг (он возвращает на тот же сервер)
local retryCount = 0
local lastRetryReset = 0
TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, message)
	if player ~= localPlayer then return end

	-- Сбрасываем счётчик попыток, если с последней ошибки прошло много времени
	if os.clock() - lastRetryReset > 30 then
		retryCount = 0
	end
	lastRetryReset = os.clock()
	retryCount += 1

	if retryCount > 5 then
		warn("[SlenderTreeHighlight] Слишком много неудачных телепортов, отмена")
		return
	end

	print("[SlenderTreeHighlight] Телепорт не удался (" .. tostring(teleportResult) .. "), пробую другой сервер: " .. tostring(message))
	task.delay(2, teleportToRandomServer)
end)

-- ===== Цикл телепорта (работает параллельно на клиенте) =====
task.spawn(function()
	local countdown = 0
	local isCounting = false

	while true do
		task.wait(CHECK_INTERVAL)

		if not hasTargets() and not isSafeTime() then
			if not isCounting then
				isCounting = true
				countdown = TELEPORT_DELAY
				print("[SlenderTreeHighlight] Цели не обнаружены, время вне 18:00-20:30. Отсчёт: " .. countdown .. "с")
			end

			countdown -= CHECK_INTERVAL
			if countdown <= 0 then
				print("[SlenderTreeHighlight] Телепортация на случайный сервер...")
				teleportToRandomServer()
				isCounting = false
			end
		else
			if isCounting then
				isCounting = false
				print("[SlenderTreeHighlight] Отмена телепорта — цели появились или время в безопасном диапазоне.")
			end
		end
	end
end)

-- Конфигурация целей поиска
local TARGETS = {
	SlenderTree = {
		fillColor = Color3.fromRGB(0, 255, 140),
		outlineColor = Color3.fromRGB(255, 255, 255),
		statusText = "SlenderTree обнаружен!",
		statusColor = Color3.fromRGB(0, 255, 140),
		countColor = Color3.fromRGB(0, 200, 110),
		indicatorColor = Color3.fromRGB(0, 255, 140),
		strokeColor = Color3.fromRGB(0, 255, 140),
		bgColor = Color3.fromRGB(15, 35, 20),
		bgColorIdle = Color3.fromRGB(15, 25, 15),
		noneText = "Нет деревьев",
		panelOffset = 0, -- 0 = верхняя панель
	},
	Witch = {
		fillColor = Color3.fromRGB(180, 0, 255),
		outlineColor = Color3.fromRGB(255, 255, 255),
		statusText = "Witch обнаружена!",
		statusColor = Color3.fromRGB(180, 0, 255),
		countColor = Color3.fromRGB(160, 0, 220),
		indicatorColor = Color3.fromRGB(180, 0, 255),
		strokeColor = Color3.fromRGB(180, 0, 255),
		bgColor = Color3.fromRGB(35, 15, 40),
		bgColorIdle = Color3.fromRGB(25, 15, 30),
		noneText = "Нет ведьм",
		panelOffset = 0.10, -- ниже на 10% от высоты экрана
	},
}

-- ===== Подсветка =====
local function addHighlight(model, targetName)
	if not model:FindFirstChild(HIGHLIGHT_NAME) then
		local config = TARGETS[targetName]
		local highlight = Instance.new("Highlight")
		highlight.Name = HIGHLIGHT_NAME
		highlight.FillColor = config.fillColor
		highlight.OutlineColor = config.outlineColor
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = model
	end
end

local function removeHighlight(model)
	local highlight = model:FindFirstChild(HIGHLIGHT_NAME)
	if highlight then
		highlight:Destroy()
	end
end

local function getTargetName(instance)
	if instance:IsA("Model") and TARGETS[instance.Name] then
		return instance.Name
	end
	return nil
end

-- ===== Создание независимых панелей =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SlenderTreeNotifications"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

-- Фабрика: создаёт одну панель для конкретного типа цели
local function createPanel(targetName, config)
	local yOffset = config.panelOffset

	local panel = Instance.new("Frame")
	panel.Name = targetName .. "Panel"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.fromScale(0.97, 0.04 + yOffset)
	panel.Size = UDim2.fromScale(0.22, 0.08)
	panel.BackgroundColor3 = config.bgColorIdle
	panel.BackgroundTransparency = 0.2
	panel.BorderSizePixel = 0
	panel.Parent = screenGui

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0.12, 0)
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Name = "Stroke"
	panelStroke.Color = Color3.fromRGB(80, 80, 80)
	panelStroke.Thickness = 1.5
	panelStroke.Transparency = 0.3
	panelStroke.Parent = panel

	local indicator = Instance.new("Frame")
	indicator.Name = "Indicator"
	indicator.AnchorPoint = Vector2.new(0, 0.5)
	indicator.Position = UDim2.fromScale(0.06, 0.5)
	indicator.Size = UDim2.fromScale(0.12, 0.55)
	indicator.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
	indicator.BorderSizePixel = 0
	indicator.Parent = panel

	local indicatorCorner = Instance.new("UICorner")
	indicatorCorner.CornerRadius = UDim.new(1, 0)
	indicatorCorner.Parent = indicator

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "StatusLabel"
	statusLabel.AnchorPoint = Vector2.new(0, 0.5)
	statusLabel.Position = UDim2.fromScale(0.22, 0.35)
	statusLabel.Size = UDim2.fromScale(0.74, 0.4)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.GothamBold
	statusLabel.Text = config.noneText
	statusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
	statusLabel.TextScaled = true
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.Parent = panel

	local statusConstraint = Instance.new("UITextSizeConstraint")
	statusConstraint.MaxTextSize = 16
	statusConstraint.MinTextSize = 8
	statusConstraint.Parent = statusLabel

	local countLabel = Instance.new("TextLabel")
	countLabel.Name = "CountLabel"
	countLabel.AnchorPoint = Vector2.new(0, 0.5)
	countLabel.Position = UDim2.fromScale(0.22, 0.72)
	countLabel.Size = UDim2.fromScale(0.74, 0.3)
	countLabel.BackgroundTransparency = 1
	countLabel.Font = Enum.Font.Gotham
	countLabel.Text = ""
	countLabel.TextColor3 = Color3.fromRGB(130, 130, 130)
	countLabel.TextScaled = true
	countLabel.TextXAlignment = Enum.TextXAlignment.Left
	countLabel.Parent = panel

	local countConstraint = Instance.new("UITextSizeConstraint")
	countConstraint.MaxTextSize = 13
	countConstraint.MinTextSize = 7
	countConstraint.Parent = countLabel

	return {
		panel = panel,
		stroke = panelStroke,
		indicator = indicator,
		statusLabel = statusLabel,
		countLabel = countLabel,
		count = 0,
	}
end

-- Создаём панель для каждого типа цели
local panels = {}
for name, config in pairs(TARGETS) do
	panels[name] = createPanel(name, config)
end

-- ===== Логика обновления каждой панели =====
local function updatePanel(targetName, newDetected)
	local p = panels[targetName]
	local config = TARGETS[targetName]
	if not p then return end

	if p.count > 0 then
		p.statusLabel.Text = config.statusText
		p.statusLabel.TextColor3 = config.statusColor
		p.countLabel.Text = "Активных: " .. p.count
		p.countLabel.TextColor3 = config.countColor
		p.indicator.BackgroundColor3 = config.indicatorColor
		p.stroke.Color = config.strokeColor
		p.stroke.Transparency = 0
		p.panel.BackgroundColor3 = config.bgColor

		-- Пульс при обнаружении новой цели
		if newDetected then
			local pulseInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(p.panel, pulseInfo, { BackgroundTransparency = 0 }):Play()
			TweenService:Create(p.indicator, pulseInfo, { BackgroundColor3 = config.indicatorColor:Lerp(Color3.new(1, 1, 1), 0.4) }):Play()
			task.delay(0.3, function()
				local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				TweenService:Create(p.panel, fadeInfo, { BackgroundTransparency = 0.2 }):Play()
				TweenService:Create(p.indicator, fadeInfo, { BackgroundColor3 = config.indicatorColor }):Play()
			end)
		end
	else
		p.statusLabel.Text = config.noneText
		p.statusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
		p.countLabel.Text = ""
		p.indicator.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		p.stroke.Color = Color3.fromRGB(80, 80, 80)
		p.stroke.Transparency = 0.3
		p.panel.BackgroundColor3 = config.bgColorIdle
	end
end

local function showNotification(targetName)
	local p = panels[targetName]
	if not p then return end
	p.count = p.count + 1
	updatePanel(targetName, true)
end

local function onTargetRemoved(targetName)
	local p = panels[targetName]
	if not p then return end
	p.count = p.count - 1
	if p.count < 0 then p.count = 0 end
	updatePanel(targetName, false)
end

-- ===== Слежение за целями (по всем потомкам Workspace, любой глубины) =====
local seen = {} -- чтобы не дублировать оповещение для одной цели

local function onTargetAdded(model, targetName)
	if seen[model] then return end
	seen[model] = true
	addHighlight(model, targetName)
	showNotification(targetName)
	model.Destroying:Connect(function()
		seen[model] = nil
		onTargetRemoved(targetName)
	end)
end

-- Подсветить уже существующие цели (поиск везде через GetDescendants)
for _, descendant in workspace:GetDescendants() do
	local targetName = getTargetName(descendant)
	if targetName then
		seen[descendant] = true
		addHighlight(descendant, targetName)
		local p = panels[targetName]
		if p then p.count = p.count + 1 end
	end
end
-- Обновить все панели после начального скана
for name in pairs(TARGETS) do
	updatePanel(name, false)
end

-- Слежение за появлением новых целей — DescendantAdded ловит любой вложенности
workspace.DescendantAdded:Connect(function(descendant)
	local targetName = getTargetName(descendant)
	if targetName then
		onTargetAdded(descendant, targetName)
	end
end)

-- Слежение за удалением целей
workspace.DescendantRemoving:Connect(function(descendant)
	local targetName = getTargetName(descendant)
	if targetName then
		removeHighlight(descendant)
	end
end)
