-- Динамически подсвечивает все модели SlenderTree и показывает оповещение
-- при спавне нового дерева. UI полностью на Scale — корректно на любых экранах.

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local HIGHLIGHT_NAME = "TreeHighlight"
local localPlayer = Players.LocalPlayer

-- ===== Подсветка =====
local function addHighlight(tree)
	if not tree:FindFirstChild(HIGHLIGHT_NAME) then
		local highlight = Instance.new("Highlight")
		highlight.Name = HIGHLIGHT_NAME
		highlight.FillColor = Color3.fromRGB(0, 255, 140)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = tree
	end
end

local function removeHighlight(tree)
	local highlight = tree:FindFirstChild(HIGHLIGHT_NAME)
	if highlight then
		highlight:Destroy()
	end
end

local function isSlenderTree(instance)
	return instance:IsA("Model") and instance.Name == "SlenderTree"
end

-- ===== Мини-панель обнаружения (постоянная) =====
