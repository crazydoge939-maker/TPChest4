-- ===== Состояние панели =====
local activeTreeCount = 0

local function updatePanel(newTreeDetected)
	if activeTreeCount > 0 then
		statusLabel.Text = "SlenderTree обнаружен!"
		statusLabel.TextColor3 = Color3.fromRGB(0, 255, 140)
		countLabel.Text = "Активных: " .. activeTreeCount
		countLabel.TextColor3 = Color3.fromRGB(0, 200, 110)
		indicator.BackgroundColor3 = Color3.fromRGB(0, 255, 140)
		panelStroke.Color = Color3.fromRGB(0, 255, 140)
		panelStroke.Transparency = 0
		panel.BackgroundColor3 = Color3.fromRGB(15, 35, 20)

		-- Пульс при обнаружении нового дерева
		if newTreeDetected then
			local pulseInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(panel, pulseInfo, { BackgroundTransparency = 0 }):Play()
			TweenService:Create(indicator, pulseInfo, { BackgroundColor3 = Color3.fromRGB(100, 255, 170) }):Play()
			task.delay(0.3, function()
				local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				TweenService:Create(panel, fadeInfo, { BackgroundTransparency = 0.2 }):Play()
				TweenService:Create(indicator, fadeInfo, { BackgroundColor3 = Color3.fromRGB(0, 255, 140) }):Play()
			end)
		end
	else
		statusLabel.Text = "Нет деревьев"
		statusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
		countLabel.Text = ""
		indicator.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		panelStroke.Color = Color3.fromRGB(80, 80, 80)
		panelStroke.Transparency = 0.3
		panel.BackgroundColor3 = Color3.fromRGB(15, 25, 15)
	end
end

local function showNotification()
	activeTreeCount = activeTreeCount + 1
	updatePanel(true)
end

local function onTreeRemoved()
	activeTreeCount = activeTreeCount - 1
	if activeTreeCount < 0 then activeTreeCount = 0 end
	updatePanel(false)
end

-- ===== Слежение за деревьями =====
local seen = {} -- чтобы не дублировать оповещение для одного дерева

local function onTreeAdded(tree)
	if seen[tree] then return end
	seen[tree] = true
	addHighlight(tree)
	showNotification()
	tree.Destroying:Connect(function()
		seen[tree] = nil
		onTreeRemoved()
	end)
end

-- Слежу за появлением/удалением деревьев в нужных контейнерах
local function watchContainer(container)
	container.ChildAdded:Connect(function(child)
		if isSlenderTree(child) then
			onTreeAdded(child)
		end
	end)
	container.ChildRemoved:Connect(function(child)
		if isSlenderTree(child) then
			removeHighlight(child)
		end
	end)
end

-- Подсветить уже существующие деревья и следить за map
local map = workspace:FindFirstChild("map")
if map then
	for _, child in map:GetChildren() do
		if isSlenderTree(child) then
			seen[child] = true
			addHighlight(child)
			activeTreeCount = activeTreeCount + 1
		end
	end
	updatePanel(false)
	watchContainer(map)
end

-- Если SlenderTree может появиться в другом месте Workspace — следим и там
watchContainer(workspace)

-- Если папка map появится позже — начнём следить и за ней
workspace.ChildAdded:Connect(function(child)
	if (child:IsA("Model") or child:IsA("Folder")) and child.Name == "map" then
		watchContainer(child)
	end
end)
